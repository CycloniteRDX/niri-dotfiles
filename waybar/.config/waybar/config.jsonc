{
    "layer": "top",
    "position": "top",

    "height": 26,

    "margin-top": 3,
    "margin-bottom": 3,
    "margin-left": 4,
    "margin-right": 4,

    "spacing": 0,
    "fixed-center": true,

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "network",
        "bluetooth",
        "pulseaudio#microphone",
        "pulseaudio#speaker",
        "backlight",
        "power-profiles-daemon",
        "battery"
    ],

    "niri/workspaces": {
        "format": "{icon}",

        "format-icons": {
            "focused": "",
            "active": "",
            "empty": "",
            "default": ""
        },

        "current-only": false,
        "display-condition": "show-all"
    },

    "clock": {
        "interval": 60,
        "format": "{:%a %m/%d · %I:%M %p}",
        "tooltip": false,
        "on-click": "gnome-calendar"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "temperature": {
        "interval": 5,

        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",

        "critical-threshold": 90,

        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",

        "tooltip": false
    },

    "network": {
        "interval": 3,
        "rfkill": true,

        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "",
        "format-disabled": " ×",

        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Wi-Fi disconnected",
        "tooltip-format-disabled": "Wi-Fi disabled",

        "on-click": "bash -c 'if [ \"$(nmcli radio wifi)\" = \"enabled\" ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'",
        "on-click-right": "kitty -e nmtui-connect"
    },

    "bluetooth": {
        "format": "",
        "format-on": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "",

        "tooltip-format": "Bluetooth",
        "tooltip-format-connected": "{device_enumerate}",

        "on-click": "bash -c 'if bluetoothctl show | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi'",
        "on-click-right": "blueman-manager"
    },

    "pulseaudio#microphone": {
        "reverse-scrolling": true,
        "reverse-mouse-scrolling": false,
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",

        "tooltip": false,

        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol -t 4",

        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    "pulseaudio#speaker": {
        "reverse-scrolling": true,
        "reverse-mouse-scrolling": false,
        "format": "{icon} {volume}%",
        "format-muted": " ×",

        "format-icons": {
            "headphone": "",
            "headset": "",
            "hands-free": "",
            "speaker": "",
            "default": [
                "",
                "",
                ""
            ]
        },

        "tooltip": false,

        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol -t 3",

        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "backlight": {
        "reverse-scrolling": true,
        "reverse-mouse-scrolling": false,
        "format": "{icon} {percent}%",

        "format-icons": [
            "󰄰",
            "󰪞",
            "󰪟",
            "󰪠",
            "󰪡",
            "󰪢",
            "󰪣",
            "󰪤",
            "󰪥"
        ],

        "tooltip": false,

        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "power-profiles-daemon": {
        "format": "{icon}",

        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        },

        "tooltip": true,
        "tooltip-format": "Power profile: {profile}"
    },

    "battery": {
        "interval": 30,

        "states": {
            "warning": 25,
            "critical": 10
        },

        "format": "{icon} {capacity}%",
        "format-charging": " {icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-full": " {capacity}%",

        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],

        "tooltip-format": "{capacity}% · {time}"
    }
}
