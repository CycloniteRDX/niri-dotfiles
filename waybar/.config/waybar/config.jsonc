{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "temperature", "network", "pulseaudio", "pulseaudio#microphone", "backlight", "battery", "tray", "custom/session"],

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "active": "●",
            "urgent": "!",
            "default": "○"
        }
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 55,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y — %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": { "mode": "month" }
    },
    "cpu": { "format": "CPU {usage}%", "tooltip": false },
    "memory": { "format": "RAM {percentage}%", "tooltip-format": "{used:0.1f} GiB used" },
    "temperature": { "format": "{temperatureC}°C", "critical-threshold": 90 },
    "network": {
        "format-wifi": "Wi-Fi {signalStrength}%",
        "format-ethernet": "Ethernet",
        "format-linked": "Linked",
        "format-disconnected": "Offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{bandwidthDownBytes} down · {bandwidthUpBytes} up",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Vol muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "pulseaudio#microphone": {
        "format": "Mic {volume}%",
        "format-muted": "Mic muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },
    "backlight": {
        "format": "Light {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "Bat {capacity}%",
        "format-charging": "Bat +{capacity}%",
        "format-plugged": "Bat AC {capacity}%",
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },
    "tray": { "spacing": 8 },
    "custom/session": {
        "format": "Exit",
        "tooltip": "End the Niri session",
        "on-click": "niri msg action quit"
    }
}
