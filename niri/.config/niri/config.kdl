// Reviewed desktop-component checkpoint for the Arch Linux post-install guide.

// Graphical authentication agent for polkit requests.
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-c" "#18181c"
spawn-at-startup "swayidle" "-w" "timeout" "300" "swaylock -f" "timeout" "600" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors" "before-sleep" "swaylock -f" "lock" "swaylock -f"

binds {
    // Mod is the Super key when Niri runs directly from a TTY.
    Mod+Return hotkey-overlay-title="Open Kitty" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Open application launcher" { spawn "fuzzel"; }
    Super+Alt+L allow-inhibiting=false hotkey-overlay-title="Lock screen" { spawn "swaylock" "-f"; }

    // Niri provides the screenshot UI and writes to the XDG Pictures directory.
    Print hotkey-overlay-title="Take interactive screenshot" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Capture focused output" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="Capture focused window" { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Niri shows a confirmation dialog before ending the session.
    Mod+Shift+E hotkey-overlay-title="Exit Niri" { quit; }
}
